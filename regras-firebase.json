{
  "rules": {
    "users": {
      "$uid": {
        "ent": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'nimialukeni007@gmail.com')",
          ".write": "auth != null && auth.token.email === 'nimialukeni007@gmail.com' && auth.token.email_verified === true"
        },
        "claimed": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && newData.val() <= root.child('users').child($uid).child('ent').child('coinsTotal').val()"
        },
        "gifts": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'nimialukeni007@gmail.com')",
          "$code": {
            ".write": "auth != null && auth.uid === $uid && ((!data.exists() && root.child('giftclaim').child($code).child('uid').val() === auth.uid && newData.child('v').val() === root.child('giftcards').child($code).child('v').val() && newData.child('k').val() === root.child('giftcards').child($code).child('k').val() && newData.child('t').val() === now) || (data.exists() && !data.child('u').exists() && newData.child('u').val() === 1))",
            ".validate": "newData.hasChildren(['v','k','t']) && (!newData.child('n').exists() || (newData.child('n').isString() && newData.child('n').val().length <= 60))"
          }
        }
      }
    },
    "requests": {
      ".read": "auth != null && auth.token.email === 'nimialukeni007@gmail.com'",
      ".indexOn": [
        "status"
      ],
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending') || (auth.token.email === 'nimialukeni007@gmail.com' && auth.token.email_verified === true))"
      }
    },
    "config": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'nimialukeni007@gmail.com' && auth.token.email_verified === true"
    },
    "pm": {
      "rooms": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('ent').child('world').val() === true",
        ".write": "auth != null && root.child('users').child(auth.uid).child('ent').child('world').val() === true"
      }
    },
    "rank": {
      ".read": "auth != null",
      ".indexOn": [
        "s",
        "r",
        "mo",
        "st"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n','s','ts']) && newData.child('n').isString() && newData.child('n').val().length <= 20 && newData.child('s').isNumber() && newData.child('s').val() >= 0 && newData.child('s').val() <= 900000 && newData.child('ts').val() === now && (!data.exists() || newData.child('ts').val() >= data.child('ts').val() + 15000) && (!newData.child('r').exists() || (newData.child('r').isNumber() && newData.child('r').val() <= 3000)) && (!newData.child('mo').exists() || (newData.child('mo').isNumber() && newData.child('mo').val() <= 300000)) && (!newData.child('st').exists() || (newData.child('st').isNumber() && newData.child('st').val() <= 500)) && (!newData.child('e').exists() || (newData.child('e').isNumber() && newData.child('e').val() <= 5000))"
      }
    },
    "profiles": {
      ".read": "auth != null",
      ".indexOn": [
        "l"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['n']) && newData.child('n').isString() && newData.child('n').val().length <= 20 && (!newData.child('p').exists() || (newData.child('p').isString() && newData.child('p').val().length <= 9000))"
      }
    },
    "presence": {
      ".read": "auth != null && auth.token.email === 'nimialukeni007@gmail.com' && auth.token.email_verified === true",
      "$uid": {
        "t": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        },
        "n": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "c": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "dm": {
      "$a": {
        "$b": {
          ".read": "auth != null && (auth.uid === $a || auth.uid === $b) && root.child('box').child($a).child('f').child($b).val() === 'ok' && root.child('box').child($b).child('f').child($a).val() === 'ok'",
          "$id": {
            ".write": "auth != null && (auth.uid === $a || auth.uid === $b) && root.child('box').child($a).child('f').child($b).val() === 'ok' && root.child('box').child($b).child('f').child($a).val() === 'ok' && !data.exists()",
            ".validate": "newData.hasChildren(['f','m','t']) && newData.child('f').val() === auth.uid && newData.child('m').isString() && newData.child('m').val().length <= 300 && newData.child('t').val() === now"
          }
        }
      }
    },
    "giftcards": {
      ".read": "auth != null && auth.token.email === 'nimialukeni007@gmail.com' && auth.token.email_verified === true",
      ".write": "auth != null && auth.token.email === 'nimialukeni007@gmail.com' && auth.token.email_verified === true",
      "$code": {
        ".write": "auth != null && data.exists() && !newData.exists() && root.child('giftclaim').child($code).child('uid').val() === auth.uid",
        ".read": "auth != null && root.child('giftclaim').child($code).child('uid').val() === auth.uid"
      }
    },
    "giftclaim": {
      ".read": "auth != null && auth.token.email === 'nimialukeni007@gmail.com' && auth.token.email_verified === true",
      "$code": {
        ".write": "auth != null && !data.exists() && root.child('giftcards').child($code).exists() && newData.child('uid').val() === auth.uid && newData.child('t').val() === now",
        ".validate": "newData.hasChildren(['uid','t'])"
      }
    },
    "box": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "f": {
          "$o": {
            ".write": "auth != null && $o !== $uid && (auth.uid === $uid || (auth.uid === $o && ((!data.exists() && newData.val() === 'in') || (data.val() === 'out' && newData.val() === 'ok') || !newData.exists())))",
            ".validate": "newData.val() === 'in' || newData.val() === 'out' || newData.val() === 'ok'"
          }
        },
        "i": {
          "$from": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $from && root.child('box').child($uid).child('f').child($from).val() === 'ok' && root.child('box').child($from).child('f').child($uid).val() === 'ok'))",
            ".validate": "!newData.exists() || (newData.hasChildren(['t','n']) && newData.child('n').isString() && newData.child('n').val().length <= 20 && (!newData.child('x').exists() || (newData.child('x').isString() && newData.child('x').val().length <= 60)))"
          }
        },
        "c": {
          "$from": {
            ".read": "auth != null && (auth.uid === $from || auth.uid === $uid)",
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $from) && root.child('box').child($uid).child('f').child($from).val() === 'ok' && root.child('box').child($from).child('f').child($uid).val() === 'ok'",
            ".validate": "!newData.exists() || (newData.hasChildren(['t']) && (!newData.child('o').exists() || newData.child('o').val().length <= 6000) && (!newData.child('a').exists() || newData.child('a').val().length <= 6000))"
          }
        }
      }
    }
  }
}